# ==============================================================================
# DSA Tracker — Backend Server Environment Template
# ==============================================================================
# DO NOT commit real secrets or production credentials to source control.
# Copy this file to .env for local development:
#   cp .env.example .env
# For Render deployment, configure these key-value pairs in the Render Dashboard.
# ==============================================================================

# Server Process Configuration
# In local development, defaults to 5000. In Render, Render automatically assigns dynamic PORT.
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Security & CORS Configuration
# Comma-separated list of allowed frontend origins (e.g. your Vercel deployment URL).
CLIENT_URL=http://localhost:5173

# JWT Secret
# Generate a cryptographically secure random secret (min 32 bytes) for production:
#   e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# MongoDB Connection String
# For MongoDB Atlas production cluster:
#   mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/dsa_tracker?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string
